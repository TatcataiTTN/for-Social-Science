<mxfile host="app.diagrams.net">
  <diagram id="pipeline" name="Pipeline">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="518" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n101" value="Pipeline nghiên cứu định lượng &amp; phân tích SPSS/PSPP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#0b0f14;fontSize=20;fontFamily=PT Sans;fontColor=#ffffff;fontStyle=1;align=center;valign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1520" height="50" as="geometry"/></mxCell><mxCell id="n102" value="1. Câu hỏi &amp; giả thuyết&#10;&#10;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Xác định biến, H0/H1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="90" width="201.71428571428572" height="110" as="geometry"/></mxCell><mxCell id="n103" value="2. Thiết kế &amp; chọn mẫu&#10;&#10;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Cỡ mẫu, xác suất/phi xác suất&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="239.71428571428572" y="90" width="201.71428571428572" height="110" as="geometry"/></mxCell><mxCell id="n104" value="3. Thu thập dữ liệu&#10;&#10;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Bảng hỏi, kiểm tra, thi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="459.42857142857144" y="90" width="201.71428571428572" height="110" as="geometry"/></mxCell><mxCell id="n105" value="4. Làm sạch dữ liệu&#10;&#10;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Ngoại lai, thiếu, mã hoá&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="679.1428571428571" y="90" width="201.71428571428572" height="110" as="geometry"/></mxCell><mxCell id="n106" value="5. Thống kê mô tả&#10;&#10;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Tần số, trung tâm, phân tán&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="898.8571428571429" y="90" width="201.71428571428572" height="110" as="geometry"/></mxCell><mxCell id="n107" value="6. Thống kê suy luận&#10;&#10;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;t/ANOVA/hồi quy + effect size&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="1118.5714285714287" y="90" width="201.71428571428572" height="110" as="geometry"/></mxCell><mxCell id="n108" value="7. Báo cáo &amp; diễn giải&#10;&#10;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Không suy nhân quả vội&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="1338.2857142857142" y="90" width="201.71428571428572" height="110" as="geometry"/></mxCell><mxCell id="n109" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b6b7f;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PT Sans;fontSize=12;fontColor=#c8d2dd;" edge="1" parent="1" source="n102" target="n103"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b6b7f;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PT Sans;fontSize=12;fontColor=#c8d2dd;" edge="1" parent="1" source="n103" target="n104"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n111" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b6b7f;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PT Sans;fontSize=12;fontColor=#c8d2dd;" edge="1" parent="1" source="n104" target="n105"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n112" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b6b7f;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PT Sans;fontSize=12;fontColor=#c8d2dd;" edge="1" parent="1" source="n105" target="n106"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n113" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b6b7f;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PT Sans;fontSize=12;fontColor=#c8d2dd;" edge="1" parent="1" source="n106" target="n107"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n114" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b6b7f;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PT Sans;fontSize=12;fontColor=#c8d2dd;" edge="1" parent="1" source="n107" target="n108"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n115" value="nếu chưa đủ bằng chứng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PT Sans;fontSize=12;fontColor=#7a1f1f;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n107" target="n104"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1219.4285714285713" y="228"/><mxPoint x="560.2857142857143" y="228"/></Array></mxGeometry></mxCell><mxCell id="n116" value="Công cụ dùng trong khoá học này" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#0b0f14;fontSize=13;fontFamily=PT Sans;fontColor=#9ca3af;fontStyle=0;align=left;valign=middle;arcSize=10;html=1;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="1520" height="34" as="geometry"/></mxCell><mxCell id="n117" value="Excel / Google Form&#10;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#4b5563&quot;&gt;thu thập&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12.5;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="294" width="366.5" height="74" as="geometry"/></mxCell><mxCell id="n118" value="PSPP (miễn phí)&#10;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#4b5563&quot;&gt;làm sạch + mô tả + suy luận&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12.5;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="404.5" y="294" width="366.5" height="74" as="geometry"/></mxCell><mxCell id="n119" value="SPSS (bản quyền trường)&#10;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#4b5563&quot;&gt;cùng cú pháp với PSPP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12.5;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="789.0" y="294" width="366.5" height="74" as="geometry"/></mxCell><mxCell id="n120" value="Python / Colab&#10;&lt;font style=&quot;font-size:10.5px&quot; color=&quot;#4b5563&quot;&gt;khi PSPP không đủ (ML, dữ liệu lớn, mẫu phức hợp)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12.5;fontFamily=PT Sans;fontColor=#1a1a1a;fontStyle=1;align=center;valign=middle;arcSize=10;html=1;" vertex="1" parent="1"><mxGeometry x="1173.5" y="294" width="366.5" height="74" as="geometry"/></mxCell><mxCell id="n121" value="⚠ Mọi mũi tên đi từ 6→7 phải kèm: cỡ hiệu ứng, khoảng tin cậy, và giới hạn suy luận nhân quả (đặc biệt với dữ liệu quan sát / không ngẫu nhiên hoá)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontFamily=PT Sans;fontColor=#5c1a1a;fontStyle=0;align=center;valign=middle;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="408" width="1520" height="70" as="geometry"/></mxCell>
      </root>
